# ============================================================
# PAYMENT SYSTEM CONFIGURATION
# Development vs Production Settings
# ============================================================

# ============================================================
# GENERAL PAYMENT SETTINGS
# ============================================================

# Payment processing environment
PAYMENT_ENV=development

# Primary payment provider (MOCK, FAWRY, PAYPAL)
PAYMENT_PROVIDER=mock

# Fallback provider(s) when primary fails (comma-separated)
PAYMENT_FALLBACK=mock

# Payment limits (in currency units)
PAYMENT_MIN_AMOUNT=1
PAYMENT_MAX_AMOUNT=10000

# Payment gateway timeout (milliseconds)
PAYMENT_TIMEOUT_MS=30000

# ============================================================
# MOCK GATEWAY (For Development/Testing)
# ============================================================

# Random failure rate for mock gateway (0-1, e.g., 0.05 = 5%)
MOCK_FAILURE_RATE=0.05

# Network delay simulation for mock gateway (milliseconds)
MOCK_NETWORK_DELAY=500

# ============================================================
# FAWRY PAYMENT GATEWAY (Egypt-based)
# Required for production payments in Egypt
# ============================================================

# Enable/Disable Fawry gateway
FAWRY_ENABLED=true

# Fawry API credentials
# Get these from: https://developer.fawry.io/
FAWRY_API_KEY=test_your_api_key_here
FAWRY_SECRET_KEY=test_your_secret_key_here
FAWRY_MERCHANT_CODE=test_merchant_code

# Test mode (set to 'true' for sandbox/testing)
FAWRY_TEST_MODE=true

# Fawry webhook secret (for signature verification)
WEBHOOK_SECRET_FAWRY=your_webhook_secret_here

# ============================================================
# PAYPAL PAYMENT GATEWAY (International)
# Fallback or alternative payment method
# ============================================================

# Enable/Disable PayPal gateway
PAYPAL_ENABLED=true

# PayPal API credentials
# Get sandbox credentials from: https://developer.paypal.com/
PAYPAL_CLIENT_ID=AcPhelHR6CkIaFXZy2jPKl37yKokQLwrKy47KJsp4qfz-RdwlW0goNyykFifhkOeI0_Fbj0khwhesqIC
PAYPAL_SECRET=EJFX5DVw50iBijtxfeVc_CICN46EsuMUFOQ6qU54Q0ANqDESzlTcKR6bRdfSLMTdfO8DcL82cVPBilru

# PayPal mode (sandbox for testing, live for production)
PAYPAL_MODE=sandbox

# PayPal webhook ID (for webhook signature verification)
PAYPAL_WEBHOOK_ID=your_webhook_id_here

# PayPal webhook secret
WEBHOOK_SECRET_PAYPAL=your_webhook_secret_here

# ============================================================
# PAYMENT RETRY POLICY
# ============================================================

# Maximum retry attempts for failed payments
PAYMENT_RETRY_MAX_ATTEMPTS=3

# Delay between retries (milliseconds)
PAYMENT_RETRY_DELAY_MS=5000

# ============================================================
# WEBHOOK CONFIGURATION
# ============================================================

# Application URL (for webhook callbacks and redirects)
APP_URL=http://localhost:3000

# Webhook timeout
WEBHOOK_TIMEOUT_MS=30000

# Webhook signature verification algorithm
WEBHOOK_SIGNATURE_ALGO=sha256

# ============================================================
# IDEMPOTENCY AND CACHING
# ============================================================

# Redis configuration (for idempotency and caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Idempotency key TTL (seconds)
IDEMPOTENCY_TTL=3600

# ============================================================
# LOGGING AND MONITORING
# ============================================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable payment transaction logging
LOG_PAYMENTS=true

# Enable webhook event logging
LOG_WEBHOOKS=true

# ============================================================
# ENVIRONMENT-SPECIFIC NOTES
# ============================================================

# DEVELOPMENT:
# - Use PAYMENT_PROVIDER=mock for all development
# - Set FAWRY_TEST_MODE=true and PAYPAL_MODE=sandbox
# - Use mock credentials for Fawry/PayPal
# - High MOCK_FAILURE_RATE to test error handling

# STAGING:
# - Use PAYMENT_PROVIDER=fawry (or paypal)
# - Set FAWRY_TEST_MODE=true (Fawry sandbox)
# - Set PAYPAL_MODE=sandbox
# - Use actual test credentials from payment providers
# - Low MOCK_FAILURE_RATE

# PRODUCTION:
# - Use PAYMENT_PROVIDER=fawry (recommended for Egypt)
# - Set FAWRY_TEST_MODE=false
# - Set PAYPAL_MODE=live
# - Use PRODUCTION credentials from payment providers
# - Store credentials in secure vault (not .env)
# - PAYMENT_FALLBACK should have backup provider
# - Enable comprehensive logging
# - Enable monitoring and alerting

# ============================================================
# SECURITY NOTES
# ============================================================

# NEVER commit real credentials to git
# Use environment variables or secure vaults:
# - AWS Secrets Manager
# - HashiCorp Vault
# - Azure Key Vault
# - Heroku Config Vars

# Example for production (using environment variables):
# export FAWRY_API_KEY=$(aws secretsmanager get-secret-value --secret-id prod/fawry/api-key)
# export PAYPAL_SECRET=$(aws secretsmanager get-secret-value --secret-id prod/paypal/secret)

# ============================================================
